# Copy to .env for local development. Use unique local-only values.
MARIADB_ROOT_PASSWORD=change-this-local-password
MARIADB_DATABASE=bloodhound
MARIADB_USER=bloodhound_app
MARIADB_PASSWORD=change-this-app-password

# Local ports only; do not expose the legacy app to the network.
MARIADB_HOST_PORT=3307
